<?xml version='1.0' encoding='utf-8'?>
<widget id="com.fitpet.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>FitPet</name>
    <description>青少年健身与宠物养成应用</description>
    <author email="support@fitpet.com" href="https://fitpet.com">FitPet团队</author>

    <!-- 应用图标 -->
    <icon src="www/icon.png" />

    <!-- 启动画面 -->
    <splash src="www/splash.png" />

    <!-- 支持平台 -->
    <platform name="android">
        <icon density="ldpi" src="www/res/icon/android/icon-36-ldpi.png" />
        <icon density="mdpi" src="www/res/icon/android/icon-48-mdpi.png" />
        <icon density="hdpi" src="www/res/icon/android/icon-72-hdpi.png" />
        <icon density="xhdpi" src="www/res/icon/android/icon-96-xhdpi.png" />
    </platform>

    <!-- 权限 -->
    <preference name="Fullscreen" value="true" />
    <preference name="Orientation" value="portrait" />

    <!-- 内容安全策略 -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
</widget>